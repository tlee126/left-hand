# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Client - Task 2.2
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local/test-only demo auth (never configure these in production)
NEXT_PUBLIC_DEMO_MODE=
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# Database - Phase 1
DATABASE_URL=
DIRECT_URL=

# Consultation rate limiting: set true only behind a proxy that overwrites
# X-Forwarded-For/X-Real-IP before forwarding requests to Next.js.
CONSULTATION_TRUSTED_PROXY=false

# Authentication - Phase 3
AUTH_SECRET=

# Storage - các phase nội dung học tập
STORAGE_BUCKET=

# Email - phase notification
EMAIL_FROM=

# Payment - Phase 7
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
