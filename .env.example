# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Client - Task 2.2
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local/test-only demo auth (never configure these in production)
NEXT_PUBLIC_DEMO_MODE=
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# Database - Phase 1
DATABASE_URL=
DIRECT_URL=

# Consultation rate limiting deployment contract:
# The preferred identity is platform-native request IP metadata. If the
# platform does not expose it, set TRUSTED_PROXY=true only for an edge that
# signs the canonical client IP in X-Consultation-Client-IP using this secret.
# X-Forwarded-For and X-Real-IP are intentionally never trusted by the route.
CONSULTATION_TRUSTED_PROXY=false
CONSULTATION_PROXY_SIGNING_SECRET=

# Server-only Supabase credential. Never expose as NEXT_PUBLIC_* or import it
# from a client component/browser module.
SUPABASE_SERVICE_ROLE_KEY=

# Authentication - Phase 3
AUTH_SECRET=

# Storage - các phase nội dung học tập
STORAGE_BUCKET=

# Email - phase notification
EMAIL_FROM=

# Payment - Phase 7
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
