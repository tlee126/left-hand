# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Client - Task 2.2
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local/test-only demo auth (never configure these in production)
NEXT_PUBLIC_DEMO_MODE=
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# Database - Phase 1
DATABASE_URL=
DIRECT_URL=

# Consultation rate limiting deployment contract:
# set true only when the terminating proxy strips inbound forwarding headers,
# writes its own X-Forwarded-For/X-Real-IP, and cannot be reached around.
# HOPS is the number of trusted proxy addresses appended to X-Forwarded-For.
# The production release checklist must attest this edge configuration; this
# file alone does not enable it in production.
CONSULTATION_TRUSTED_PROXY=false
CONSULTATION_TRUSTED_PROXY_HOPS=1

# Authentication - Phase 3
AUTH_SECRET=

# Storage - các phase nội dung học tập
STORAGE_BUCKET=

# Email - phase notification
EMAIL_FROM=

# Payment - Phase 7
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
